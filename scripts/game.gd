	collab_effects.append({"kind": "shockwave", "pos": pos, "radius": 230.0, "life": 0.72, "maxLife": 0.72, "color": Color("#5bc8ff")})
	_push_time_toast("VS MODE：敵と連携が加速！", 1.35)
