		_relay_boss_spawn_no_reward_summon(pos, 8.0, "noise_ghost_comment", "travel_support")

func _relay_boss_spawn_collab_break_core(pos: Vector2, _arena: Rect2, _rng: RandomNumberGenerator) -> int:
