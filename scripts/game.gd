		return false
	if song_max_octave_audience_call_wave_cooldown > 0.0:
		return false
	var arena := _current_arena()
	_spawn_song_audience_call_wave(arena)
	song_max_octave_audience_call_wave_cooldown = SONG_MAX_OCTAVE_AUDIENCE_CALL_WAVE_COOLDOWN
